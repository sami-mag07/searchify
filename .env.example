# ------------------------------------------------------------------
# Beispiel-Konfiguration. Kopieren nach `.env` und echte Werte eintragen.
# NIEMALS echte Secrets in diese Datei schreiben - nur Platzhalter.
# `.env` ist in .gitignore und wird nie committet.
# ------------------------------------------------------------------

# --- Such-Backend ---
# searxng (self-host, Default) | serper (Google-SERP-API, am schnellsten) | ddgs (ohne Key, langsam)
SEARCH_BACKEND=searxng
# Ausweich-Backend, wenn das erste ausfaellt (z. B. Serper-Guthaben leer). Leer = keins.
SEARCH_FALLBACK=
# Nur fuer SEARCH_BACKEND=serper. Platzhalter - echten Wert nur in .env eintragen.
SERPER_API_KEY=
# Langsame Serper-Antwort: nach so vielen ms eine zweite Anfrage parallel (0 = aus).
SEARCH_HEDGE_MS=900

# --- SearXNG (self-host) ---
# URL der eigenen SearXNG-Instanz. JSON-Ausgabe muss aktiviert sein.
# Lokaler Docker-Default laut deploy/docker-compose.yml: Port 8888.
SEARXNG_URL=http://localhost:8888
# Pflicht-Secret fuer SearXNG. Der Docker-Entrypoint ersetzt damit den
# Platzhalter in deploy/searxng/settings.yml. Eigenen Zufallswert eintragen,
# z. B. mit:  openssl rand -hex 32
SEARXNG_SECRET=bitte-zufaelligen-wert-eintragen

# --- Antwort-LLM: Claude ueber claude-code-api (OpenAI-kompatibel) ---
# Base-URL des lokalen OpenAI-kompatiblen Wrappers (claude-code-api).
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Token des Wrappers. Platzhalter - echten Wert nur in .env eintragen.
OPENAI_API_KEY=dein-claude-code-api-token
# Modell-Alias, den der Wrapper versteht (z. B. opus / sonnet / ein Claude-Modell-Alias).
OPENAI_MODEL=opus

# --- Reranker: lokaler Cross-Encoder (transformers, CUDA/MPS wenn vorhanden) ---
# Default mMiniLM (mehrsprachig, ~3x schneller als bge-reranker-base bei gleicher Trefferquote).
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# true = FP16 auf GPU/MPS (auf CPU immer FP32).
RERANKER_USE_FP16=true
# Max. Tokens je Query+Chunk-Paar und Chunks je Seite, die in den Cross-Encoder gehen.
RERANK_MAX_LENGTH=256
RERANK_CHUNKS_PER_PAGE=3

# --- Eigener Dienst (optionaler Schutz des /search-Endpunkts) ---
# Wenn gesetzt, muss jeder Request diesen Key liefern (Body-Feld api_key
# oder Header "Authorization: Bearer ..."). Leer lassen = kein Auth-Zwang.
SERVICE_API_KEY=

# --- Pipeline-Tuning (optional, Defaults siehe app/config.py) ---
# Kandidaten pro Query aus dem Such-Backend (mindestens max_results).
CANDIDATE_POOL=10
# Wort-Fenster und Overlap fuer das Chunking.
CHUNK_SIZE=100
CHUNK_OVERLAP=20
# Timeout je Quell-URL (Sekunden). Laeuft im Hintergrund weiter, wenn das Budget vorbei ist.
FETCH_TIMEOUT=5
# Wie lange eine Anfrage auf Seiten wartet: basic / advanced (fast = 0, nur Snippets + Cache).
FETCH_BUDGET_MS=300
FETCH_BUDGET_ADVANCED_MS=1500
# Seiten-Cache im Speicher (verspaetete Downloads landen hier). TTL 0 = aus.
PAGE_CACHE_SIZE=5000
PAGE_CACHE_TTL_S=21600

# ------------------------------------------------------------------
# NUR fuer eval/compare_tavily.py (separates, nicht ausgefuehrtes Skript).
# Ohne diesen Key laeuft der Vergleich nicht. Nutzung auf eigenes
# ToS-Risiko des Betreibers. Ergebnisse NICHT veroeffentlichen.
# ------------------------------------------------------------------
TAVILY_API_KEY=
