# ------------------------------------------------------------------
# Beispiel-Konfiguration. Kopieren nach `.env` und echte Werte eintragen.
# NIEMALS echte Secrets in diese Datei schreiben - nur Platzhalter.
# `.env` ist in .gitignore und wird nie committet.
# ------------------------------------------------------------------

# --- Such-Backend ---
# searxng (self-host, Default) | serper (Google-SERP-API, am schnellsten) | ddgs (ohne Key, langsam)
SEARCH_BACKEND=searxng
# Ausweich-Backend, wenn das erste ausfaellt (z. B. Serper-Guthaben leer). Leer = keins.
SEARCH_FALLBACK=
# Nur fuer SEARCH_BACKEND=serper. Platzhalter - echten Wert nur in .env eintragen.
SERPER_API_KEY=
# Langsame Serper-Antwort: nach so vielen ms eine zweite Anfrage parallel (0 = aus).
SEARCH_HEDGE_MS=900
# Trefferlisten-Cache: so lange frisch, danach bis 24 h stale-while-revalidate. 0 = aus.
SEARCH_CACHE_TTL_S=3600

# --- SearXNG (self-host) ---
# Engines einzeln fragen und mit der schnellsten schon Seiten laden (app/stream.py).
# Leer = aus (eine gemeinsame Anfrage, wartet auf die langsamste Engine).
SEARXNG_SPLIT_ENGINES=bing,yahoo
# Je Sprache abweichend (Bing liefert ueber SearXNG bei es/fr nichts). Yandex ist ein
# russischer Anbieter; wer das nicht will, setzt hier z. B. nur yahoo.
SEARXNG_SPLIT_ENGINES_ES=yandex,yahoo
SEARXNG_SPLIT_ENGINES_FR=yandex,yahoo
SPLIT_PER_ENGINE=7
# Ergebnisseiten je blaetternder Engine (yahoo/yandex), wenn mehr als 10 Quellen
# gewuenscht sind (max_results > 10). 3 holt mehr Gold-Quellen (Recherche site@30
# 0.106 -> 0.119), kostet eine parallele Anfrage und ~7 Seiten mehr zum Laden.
SPLIT_PAGES_WIDE=3
SPLIT_SEARCH_TIMEOUT_MS=2500
# Engine nach so vielen ms noch nicht da: zweite Anfrage parallel (0 = aus).
SPLIT_HEDGE_MS=1000
# Nach der letzten Engine noch so lange auf Seiten warten. Die Antwort steht fast
# immer schon in den Snippets (live 20 Fragen: Wartezeit nach der Suche 0.28 -> 0.21 s).
SPLIT_TAIL_MS=120
# Reranker beim Start im Hintergrund laden und einmal rechnen (0 = aus).
# Ohne das dauert die erste Anfrage nach dem Start ~10-16 s.
RERANK_WARMUP=1
# URL der eigenen SearXNG-Instanz. JSON-Ausgabe muss aktiviert sein.
# Lokaler Docker-Default laut deploy/docker-compose.yml: Port 8888.
SEARXNG_URL=http://localhost:8888
# Pflicht-Secret fuer SearXNG. Der Docker-Entrypoint ersetzt damit den
# Platzhalter in deploy/searxng/settings.yml. Eigenen Zufallswert eintragen,
# z. B. mit:  openssl rand -hex 32
SEARXNG_SECRET=bitte-zufaelligen-wert-eintragen

# --- Antwort-LLM: Claude ueber claude-code-api (OpenAI-kompatibel) ---
# Base-URL des lokalen OpenAI-kompatiblen Wrappers (claude-code-api).
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Token des Wrappers. Platzhalter - echten Wert nur in .env eintragen.
OPENAI_API_KEY=dein-claude-code-api-token
# Modell-Alias, den der Wrapper versteht (z. B. opus / sonnet / ein Claude-Modell-Alias).
OPENAI_MODEL=opus

# --- Reranker: lokaler Cross-Encoder (transformers, CUDA/MPS wenn vorhanden) ---
# Default mMiniLM (mehrsprachig, ~3x schneller als bge-reranker-base bei gleicher Trefferquote).
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# true = FP16 auf GPU/MPS (auf CPU immer FP32).
RERANKER_USE_FP16=true
# Max. Tokens je Query+Chunk-Paar und Chunks je Seite, die in den Cross-Encoder gehen.
RERANK_MAX_LENGTH=256
RERANK_CHUNKS_PER_PAGE=2
# Streckung des ausgegebenen score: sigmoid(logit / T). Sortiert wird immer nach dem Logit.
SCORE_TEMPERATURE=4
# Rang-Fusion (RRF) aus Cross-Encoder-Rang und Engine-Rang (Bing/Yahoo/Yandex): Gewicht des
# Engine-Rangs (0 = aus) und RRF-Konstante k. Replay dev: hist_mrr 0.24 -> 0.31.
FUSION_WEIGHT=0.5
FUSION_K=30
# Engine-Vertrauen je Anfrage: Engine-Rang zaehlt nur mit dem Anteil ihrer Treffer,
# deren Cross-Encoder-Logit >= diesem Wert liegt (Engine hat die Anfrage verstanden).
FUSION_TRUST_MIN=0
# Quellenqualitaet ohne Domain-Liste (app/quality.py): Abzug auf den Cross-Encoder-Logit fuer
# SEO-/Antwortfarm-Muster in URL und Titel, nur bei Fragen in Satzform und nur fuer Quellen
# ohne festen Quellen-Prior. Blindtest 13.10.: Vertrauen 3,32 -> 3,51 (Tavily 3,56), daher an.
QUALITY_PRIOR=true
QUALITY_PRIOR_WEIGHT=1.0
# Auch fuer /serper und /exa (dort fielen die Pruefwerte leicht), Standard aus.
QUALITY_PRIOR_COMPAT=false

# --- Eigener Dienst (optionaler Schutz des /search-Endpunkts) ---
# Wenn gesetzt, muss jeder Request diesen Key liefern (Body-Feld api_key
# oder Header "Authorization: Bearer ..."). Leer lassen = kein Auth-Zwang.
SERVICE_API_KEY=

# --- Pipeline-Tuning (optional, Defaults siehe app/config.py) ---
# Kandidaten pro Query aus dem Such-Backend (mindestens max_results).
CANDIDATE_POOL=10
# Wort-Fenster und Overlap fuer das Chunking.
CHUNK_SIZE=100
CHUNK_OVERLAP=20
# Timeout je Quell-URL (Sekunden). Laeuft im Hintergrund weiter, wenn das Budget vorbei ist.
FETCH_TIMEOUT=5
# httpx (Default) | curl_cffi (Chrome-TLS-Profil, weniger 403; im Test gleich schnell)
FETCH_CLIENT=httpx
# Reader (/jina/r, /extract): Seiten ohne lesbaren Text im Headless-Chromium nachrendern
# (JS-Seiten/SPAs, max. 2 je Anfrage, eine gleichzeitig, alle Anfragen ueber den SSRF-geschuetzten Client).
# Braucht playwright + `.venv/bin/python -m playwright install chromium-headless-shell`; 0 = aus.
READER_RENDER=1
# Prozesse fuer die Text-Extraktion (0 = Kerne - 1, max. 8).
EXTRACT_WORKERS=0
# Wie lange eine Anfrage auf Seiten wartet: basic / advanced (fast = 0, nur Snippets + Cache).
FETCH_BUDGET_MS=500
FETCH_BUDGET_ADVANCED_MS=1500
# Seiten-Cache im Speicher (verspaetete Downloads landen hier). TTL 0 = aus.
PAGE_CACHE_SIZE=5000
PAGE_CACHE_TTL_S=21600

# ------------------------------------------------------------------
# NUR fuer eval/compare_tavily.py (separates, nicht ausgefuehrtes Skript).
# Ohne diesen Key laeuft der Vergleich nicht. Nutzung auf eigenes
# ToS-Risiko des Betreibers. Ergebnisse NICHT veroeffentlichen.
# ------------------------------------------------------------------
TAVILY_API_KEY=
