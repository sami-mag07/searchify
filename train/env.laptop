# .env fuer den Laptop. Kopieren nach .env im Repo-Ordner:
#   Linux/WSL2:  cp train/env.laptop .env
#   Windows:     copy train\env.laptop .env
# Enthaelt keine Schluessel. Die Werte muessen genau so bleiben wie auf dem Mac,
# sonst passen die Aufnahmen in eval/private/replay nicht: Der Schluessel jeder
# Aufnahme enthaelt die SearXNG-Adresse (app/search.py, _replay_path).
SEARCH_BACKEND=searxng
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_SPLIT_ENGINES=bing,yahoo
# Auf dem Mac steht hier ddgs. Offline auf dem Laptop leer lassen (sonst Live-Rueckfall
# auf DuckDuckGo, sobald eine Aufnahme fehlt). Tavily/Serper/Exa nie eintragen.
SEARCH_FALLBACK=
# Nur fuer SearXNG per Docker. Eigenen Zufallswert eintragen, nie committen:
#   python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
